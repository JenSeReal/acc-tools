{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACC Tools",
  "version": "0.1.0",
  "identifier": "one.jfp.acc-tools-ui",
  "build": {
    "beforeDevCommand": "trunk serve --config ../Trunk.toml",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --config ../Trunk.toml",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ACC Tools",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
