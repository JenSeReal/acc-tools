{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoTeC Telemetry Viewer",
  "version": "0.1.0",
  "identifier": "one.jfp.motec-viewer",
  "build": {
    "beforeDevCommand": "trunk serve --config ../Trunk.toml",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "trunk build --config ../Trunk.toml",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MoTeC Telemetry Viewer",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
